---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...rest] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<header class="page-head">
				<p class="eyebrow">Writing</p>
				<h1>Notes &amp; guides</h1>
				<p class="lede">
					Short, practical pieces on building a Shopify store that sells — setup, conversion,
					and the small tools that do the heavy lifting.
				</p>
			</header>

			{posts.length === 0 ? (
				<p class="empty">No posts yet. Check back soon.</p>
			) : (
				<section aria-label="Blog posts">
					{featured && (
						<a class="featured" href={`/blog/${featured.id}/`}>
							{featured.data.heroImage && (
								<div class="thumb thumb--featured">
									<Image
										width={1200}
										height={600}
										src={featured.data.heroImage}
										alt={featured.data.title}
										loading="eager"
									/>
								</div>
							)}
							<div class="meta">
								<FormattedDate date={featured.data.pubDate} />
							</div>
							<h2 class="featured-title">{featured.data.title}</h2>
							{featured.data.description && (
								<p class="excerpt">{featured.data.description}</p>
							)}
						</a>
					)}

					{rest.length > 0 && (
						<ul class="grid">
							{rest.map((post) => (
								<li>
									<a class="card" href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<div class="thumb">
												<Image
													width={720}
													height={400}
													src={post.data.heroImage}
													alt={post.data.title}
													loading="lazy"
												/>
											</div>
										)}
										<div class="meta">
											<FormattedDate date={post.data.pubDate} />
										</div>
										<h3 class="card-title">{post.data.title}</h3>
										{post.data.description && (
											<p class="excerpt">{post.data.description}</p>
										)}
									</a>
								</li>
							))}
						</ul>
					)}
				</section>
			)}
		</main>

		<Footer />
	</body>
</html>

<style>
	/* --- Layout ---------------------------------------------------------- */
	main {
		--ink: rgb(var(--black, 20 22 26));
		--ink-soft: rgb(var(--gray, 100 110 125));
		--accent: rgb(var(--accent, 63 107 43));
		--line: color-mix(in srgb, var(--ink) 12%, transparent);
		--radius: 14px;

		width: 100%;
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1.25rem 6rem;
		color: var(--ink);
	}

	/* --- Page header ----------------------------------------------------- */
	.page-head {
		padding: 4.5rem 0 3rem;
		max-width: 42rem;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.page-head h1 {
		margin: 0;
		font-size: clamp(1.875rem, 4vw, 2.75rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.lede {
		margin: 1rem 0 0;
		font-size: 1.0625rem;
		line-height: 1.65;
		color: var(--ink-soft);
		text-wrap: pretty;
	}

	/* --- Shared card pieces ---------------------------------------------- */
	.meta {
		font-size: 0.8125rem;
		color: var(--ink-soft);
		letter-spacing: 0.01em;
	}

	.excerpt {
		margin: 0.5rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--ink-soft);
		text-wrap: pretty;
	}

	.thumb {
		overflow: hidden;
		border-radius: var(--radius);
		margin-bottom: 1rem;
		background: color-mix(in srgb, var(--ink) 5%, transparent);
	}

	.thumb :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.thumb--featured :global(img) {
		aspect-ratio: 2 / 1;
	}

	/* --- Featured post --------------------------------------------------- */
	.featured {
		display: block;
		text-decoration: none;
		color: inherit;
		margin-bottom: 3.5rem;
	}

	.featured-title {
		margin: 0.5rem 0 0;
		font-size: clamp(1.5rem, 3vw, 2rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
		text-wrap: balance;
		transition: color 0.15s ease;
	}

	.featured:hover .featured-title {
		color: var(--accent);
	}

	.featured:hover .thumb :global(img) {
		transform: scale(1.02);
	}

	/* --- Grid of remaining posts ----------------------------------------- */
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2.5rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.card-title {
		margin: 0.4rem 0 0;
		font-size: 1.125rem;
		line-height: 1.3;
		letter-spacing: -0.01em;
		text-wrap: balance;
		transition: color 0.15s ease;
	}

	.card:hover .card-title {
		color: var(--accent);
	}

	.card:hover .thumb :global(img) {
		transform: scale(1.03);
	}

	/* --- Empty state ----------------------------------------------------- */
	.empty {
		padding: 3rem 0;
		color: var(--ink-soft);
	}

	/* --- A11y ------------------------------------------------------------ */
	main a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
		border-radius: 6px;
	}

	@media (prefers-reduced-motion: reduce) {
		.thumb :global(img),
		.featured-title,
		.card-title {
			transition: none !important;
		}
	}

	/* --- Responsive ------------------------------------------------------ */
	@media (max-width: 720px) {
		.page-head {
			padding: 3rem 0 2rem;
		}

		.grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.featured {
			margin-bottom: 2.5rem;
		}

		.thumb--featured :global(img) {
			aspect-ratio: 16 / 9;
		}
	}
</style>
